# Windows CI failure (2026-08-11, PR #48): this file itself is a plain text
# file and was subject to the exact core.autocrlf gotcha it exists to guard
# against -- self-pin so its own bytes don't shift on a Windows checkout.
.gitattributes text eol=lf

tests/corpus/manifest.json text eol=lf
# The committed corpus-golden snapshot family's eol=lf pin was removed here
# by item 126, which retired the family (docs/aide/golden-decision-table.md's
# "## Retirement execution log"); tests/corpus/fixtures/*.nii.gz below is
# untouched -- the corpus itself survives.
tests/corpus/fixtures/*.nii.gz binary
src/segfacet/reference/reference_default.json text eol=lf
src/segfacet/reference/reference_verse_*.json text eol=lf
tests/corpus/intensity/manifest.json text eol=lf
tests/corpus/intensity/fixtures/*.nii.gz binary
tests/corpus/094_pre_migration_snapshot.json text eol=lf
# Item 119's pre-119 blast-radius digests. Read via read_text(), so a CRLF
# checkout would not break it today, but pinned on the same principle as
# every committed text fixture above rather than relying on that.
tests/corpus/119_pre_119_digests.json text eol=lf

# Items 099-101 introduced "scope fence" tests that hash committed source
# files verbatim (read_bytes()) to prove later items didn't touch them.
# Those files were never pinned, so a Windows checkout's default
# core.autocrlf rewrites their committed LF to CRLF and the pinned hash
# never matches -- the same class of bug as the fixtures above, just
# applied to plain source instead of generated fixtures. Pin the whole
# tree these tests draw from, not just the currently-hashed files, so a
# future item adding another such test doesn't reopen this on a new path.
src/segfacet/**/*.py text eol=lf
src/segfacet/**/*.json text eol=lf
# Windows CI failure (2026-08-11, PR #48): the two whole-tree-hash tests
# (items 099-101, item 105's AC14) walk *every* file under src/segfacet/**,
# not just *.py/*.json -- these two .yaml files fell outside both globs
# above and broke the hash on a Windows checkout the same way.
src/segfacet/**/*.yaml text eol=lf

# Item 103's generated feature & rule catalogue -- byte-reproducible fixtures
# (AC19) subject to the same Windows core.autocrlf gotcha as the pins above.
docs/aide/feature_catalogue.generated.json text eol=lf
docs/aide/feature_catalogue.generated.md text eol=lf

# Item 134's golden decision table evidence companion -- byte-reproducible,
# same Windows core.autocrlf gotcha as the pins above.
docs/aide/golden_evidence.generated.json text eol=lf

# Item 105's golden-file decision table (AC1: must be write_bytes with \n
# newlines) -- same Windows core.autocrlf gotcha as everything else here.
docs/aide/golden-decision-table.md text eol=lf

# Item 111: 016_features_report.json and 022_stage3_report.json were the only
# committed byte-reproducible text fixtures still unpinned -- latent only
# because both consumers compare via read_text(), whose universal-newline
# translation silently normalises a CRLF checkout back to \n. Pin them before
# any future comparison switches to read_bytes() and reproduces the same
# Windows-CI-only failure documented above for items 099-101.
tests/golden/*.json text eol=lf
