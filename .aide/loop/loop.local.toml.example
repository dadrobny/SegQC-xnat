# Personal, per-machine config for AIDE. Copy this file to loop.local.toml
# (gitignored) and edit. Nothing here is shared or committed.
#
# Two independent consumers read this file:
#   [loop]                  — the loop supervisor (.aide/loop/loop.py).
#   [framework] [hygiene]   — the Claude adapter's command-hygiene guard (only
#                             when that adapter is installed). Set any, all, or
#                             none. [framework] names the framework clone
#                             specifically; [hygiene] names other repos this
#                             project spans.

[loop]
# Stop once the 7-day utilization reaches this percent (0 disables).
max_weekly_pct = 95

# Reserve this many percent of the weekly budget per whole day still left before
# the weekly reset (0 disables). The effective weekly ceiling is the smaller of
# max_weekly_pct and 100 - daily_reserve_pct * days_left, so it rises toward 100
# as the reset nears.
daily_reserve_pct = 10

# Treat the 5-hour/session window as exhausted at this percent (then WAIT for reset).
max_session_pct = 98

# Seconds of slack added when sleeping until a window resets.
buffer_seconds = 30

# Seconds to wait between passes after a normal RUN.
interval = 300

# Fallback wait (seconds) if a WAIT is chosen but no reset time is available.
wait_fallback = 900

# Which usage probe supplies the RUN/WAIT/STOP numbers.
#   "anthropic-oauth" — the Claude adapter's probe (.aide/loop/usage_probe.py):
#                       reads the OAuth usage endpoint and gates on the caps above.
#   "none"            — no usage API; relaunch on a plain time cadence (`interval`),
#                       ignoring the weekly/session caps. Use for runtimes/plans
#                       without a usage endpoint.
usage_probe = "anthropic-oauth"

# Deadline: once the clock passes this, the loop finishes the current run and
# exits without restarting. Any ISO-8601 datetime (e.g. "2026-06-30T09:00" or
# "2026-06-30 09:00"). Empty = run indefinitely.
stop_after = ""

# Override the OAuth credentials file (empty = ~/.claude/.credentials.json).
credentials_path = ""

# Command to run each pass (empty = `claude -p "/aide-run-roadmap"` — a top-level
# print-mode session that exits when the step finishes; an interactive session
# would never return control to the supervisor). Permissions must come from the
# committed .claude/settings.json allow-list: in print mode an unlisted call is
# DENIED, not prompted — fix that by extending the allow-list via
# /aide-review-permissions, never by adding a skip-permissions flag here. The
# ERR/re-auth path runs this same plain command — never pass a removed
# --continuous flag.
command = ""

[framework]
# Local checkout of the aide-loop framework repo itself, for the documented
# framework-update workflow (CLAUDE.md > "Updating the framework"). Declaring
# it here — not in the shared, committed aide.toml — gives the Claude
# adapter's command-hygiene guard a narrow `git -C <local_path>` carve-out
# without putting a machine-specific filesystem path in a committed file.
# Empty/absent = the workflow's `git -C` step stays blocked (the default,
# safe posture for anyone not actively developing the framework).
local_path = ""

[hygiene]
# Other git repos this project legitimately spans, for the Claude adapter's
# command-hygiene guard. One project can span two repos developed together —
# a library and a sibling programme repo, say. Without a declaration the guard
# refuses every git operation against the sibling, while `git init` and plain
# file writes (both take a path argument) sail through: an agent can create
# the repo and write into it but never `add`/`commit`, leaving the work
# uncommitted for a human to finish by hand.
#
# Named for its only consumer — this guard. Listing a path here RELAXES ONE
# LINT AND GRANTS NO PERMISSION: the command still has to match the
# allow-list to auto-approve, and `git -C …` matches none of the
# `Bash(git <subcommand>:*)` rules, so it prompts. That is intended — the
# guard exists to stop shapes that would stall an unattended run, not to be a
# trust boundary.
#
# Two different repos in ONE command stay blocked even when both are listed:
# history read from one repo and applied to another's working tree is a shape
# no legitimate workflow needs.
#
# Machine-specific paths, so they live here and never in the committed
# aide.toml. Empty/absent (the default) = every repo-override form blocked.
extra_repos = []
